# Copy to .env.aws on the EC2 host (mode 600) - rendered from SSM Parameter Store
# at deploy time; NEVER commit the filled-in file. Used with docker-compose.aws.yml.
# Names only - see docs/09-deployment-operations/AWS_PRODUCTION_PLAN.md.

# Domains (DNS A records -> the Elastic IP)
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
SITE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# Amazon RDS (private endpoint). Keep ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/gawachabazaar?sslmode=require

# Firebase (per environment: separate Firebase projects)
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_ME
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=CHANGE_ME
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME

# Razorpay: rzp_test_ keys on staging, rzp_live_ on production only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Delivery: the REAL warehouse (or choose the packing point in Admin -> Settings)
PACKING_POINT_LATITUDE=
PACKING_POINT_LONGITUDE=
DELIVERY_BASE_FEE=20
DELIVERY_PER_KM=10
DELIVERY_MAX_DISTANCE_KM=0
DELIVERY_MIN_ORDER_VALUE=0

# Routing: self-hosted OSRM data built by deploy/osrm/build.sh
OSRM_DATA_DIR=./osrm-data
# OSRM_BASE_URL defaults to http://osrm:5000 in docker-compose.aws.yml
# REDIS_URL defaults to redis://redis:6379/0
NOMINATIM_USER_AGENT=GawachaBazaar/1.0 (you@example.com)
