# Gawacha Bazaar - production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Lives ONLY on the server, never committed (.gitignore covers .env.*).
# deploy/scripts/deploy.sh refuses to run while any CHANGE_ME remains.
#
# Generate secrets on the server with:   openssl rand -hex 32
# (hex keeps them URL-safe - POSTGRES_PASSWORD is embedded in DATABASE_URL,
# so avoid @ : / ? # in it.)

# --- Domains (DNS A records must point at the Contabo server's IPv4) -------
SITE_DOMAIN=CHANGE_ME.example.com
ADMIN_DOMAIN=admin.CHANGE_ME.example.com
API_DOMAIN=api.CHANGE_ME.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=CHANGE_ME@example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=gawacha
POSTGRES_DB=gawachabazaar
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- Backend secrets (startup fails closed if placeholder or < 32 chars) ----
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Razorpay (online payments: UPI, cards, netbanking, wallets) -------------
# Leave RAZORPAY_KEY_ID empty to run Cash-on-Delivery only. Once the key id is
# set, the secret and webhook secret are required (startup fails otherwise).
# Dashboard -> Account & Settings -> API Keys (rzp_live_... for real money,
# rzp_test_... for test mode). Webhook secret = the one you type when
# creating the webhook (see deploy/README.md -> Payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (product/category image uploads) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
