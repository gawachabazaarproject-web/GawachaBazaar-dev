# Gawacha Bazaar - production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Lives ONLY on the server, never committed (.gitignore covers .env.*).
# deploy/scripts/deploy.sh refuses to run while any CHANGE_ME remains.
#
# Generate secrets on the server with:   openssl rand -hex 32
# (hex keeps them URL-safe - POSTGRES_PASSWORD is embedded in DATABASE_URL,
# so avoid @ : / ? # in it.)

# --- Domains (DNS A records must point at the Contabo server's IPv4) -------
SITE_DOMAIN=CHANGE_ME.example.com
ADMIN_DOMAIN=admin.CHANGE_ME.example.com
API_DOMAIN=api.CHANGE_ME.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=CHANGE_ME@example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=gawacha
POSTGRES_DB=gawachabazaar
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- Firebase Authentication (startup fails closed without the project id) --
FIREBASE_PROJECT_ID=
# Service-account key JSON on one line. Secret: set it in the host's secret
# store (e.g. your cloud secret manager), never in a committed file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin panel web config (public identifiers, NOT secrets) - baked into the
# Admin image at build time. Firebase Console -> Project settings -> Your apps -> Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Razorpay (online payments: UPI, cards, netbanking, wallets) -------------
# Leave RAZORPAY_KEY_ID empty to run Cash-on-Delivery only. Once the key id is
# set, the secret and webhook secret are required (startup fails otherwise).
# Dashboard -> Account & Settings -> API Keys (rzp_live_... for real money,
# rzp_test_... for test mode). Webhook secret = the one you type when
# creating the webhook (see deploy/README.md -> Payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (product/category image uploads) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Delivery pricing / Bazaar offer (free delivery at 10+ different products; else base + per-km
# from the packing point). Set the packing point so the per-km part applies.
FREE_DELIVERY_MIN_ITEMS=10
DELIVERY_BASE_FEE=20
DELIVERY_PER_KM=10
DELIVERY_MAX_CHARGED_KM=30
# Owner decision (2026-10-27): base delivery fee is Rs 20 everywhere. Make sure the host's own
# environment does NOT override DELIVERY_BASE_FEE with an old value (e.g. 40).
# Fee = DELIVERY_BASE_FEE + DELIVERY_PER_KM x ceil(road km), minimum 1 km.
# COD delivery OTP (proof of delivery). The server keeps only an HMAC of each code, keyed by
# DELIVERY_OTP_SECRET. Production REFUSES TO START with ENFORCED=true and a secret < 32 chars.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"  (never commit it)
DELIVERY_OTP_ENFORCED=true
DELIVERY_OTP_SECRET=
DELIVERY_OTP_EXPIRY_MINUTES=240
DELIVERY_OTP_MAX_ATTEMPTS=5
DELIVERY_OTP_RESEND_LIMIT=3
DELIVERY_OTP_RESEND_WINDOW_MINUTES=15

# Refer & Earn (OFF by default) and partner earnings: placeholders, see docs/05-domains/REFERRAL_SYSTEM.md
REFERRAL_ENABLED=false
REFERRAL_REFERRER_REWARD=50
REFERRAL_REFERRED_REWARD=50
REFERRAL_MIN_ORDER_VALUE=199
PARTNER_EARNING_BASE=20
PARTNER_EARNING_PER_KM=5
PACKING_POINT_LATITUDE=
PACKING_POINT_LONGITUDE=
# Road distance (OpenStreetMap, no paid API). The public OSRM server is for
# development only - self-host OSRM before launch (docs/05-domains/DELIVERY.md).
# If routing is down the delivery quote fails (503); no straight-line guess.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=3
# Customers farther than this by road are refused (0 = no limit); minimum order (0 = off)
DELIVERY_MAX_DISTANCE_KM=0
DELIVERY_MIN_ORDER_VALUE=0
# Database pool + guards (per worker; production runs ONE worker). In-flight cap
# must be <= pool_size + max_overflow. See docs/09-deployment-operations/AWS_PRODUCTION_PLAN.md
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=12
MAX_INFLIGHT_REQUESTS=24
DB_STATEMENT_TIMEOUT_MS=20000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Route-distance cache. Empty REDIS_URL = in-process cache; Redis outage never breaks delivery.
REDIS_URL=
ROUTE_CACHE_TTL_SECONDS=604800
# Address search (customer presses Search; never autocomplete on the public server)
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GawachaBazaar/1.0 (you@example.com)
BAZAAR_PLUS_ORDERS_REQUIRED=6
BAZAAR_TIMEZONE=Asia/Kolkata
