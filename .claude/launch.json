{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gawacha-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "website"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "mobile"],
      "port": 8081
    },
    {
      "name": "gawacha-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "Admin"],
      "port": 3001
    },
    {
      "name": "gawacha-backend",
      "runtimeExecutable": "backend/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--env-file", "backend/.env", "--reload", "--reload-dir", "backend/app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "gawacha-backend-8001",
      "runtimeExecutable": "backend/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--env-file", "backend/.env", "--reload", "--reload-dir", "backend/app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    }
  ]
}
