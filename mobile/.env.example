# Copy to .env and fill in for local development.
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time -
# never put secrets here. The mobile app has none to store (see docs/API.md).

# Base URL of the GawachaBazaar backend API (FastAPI), including /api/v1.
#
# - Android emulator (AVD) reaching a backend on the same host machine:
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# - iOS simulator (same machine as the backend):
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# - Physical device (Expo Go / dev build) on the same Wi-Fi as your machine:
#     EXPO_PUBLIC_API_BASE_URL=http://<your-computer-LAN-IP>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
