# Application Configuration
APP_NAME=GawachaBazaar
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Firebase Authentication (identity provider)
# Project id: Firebase Console -> Project settings -> General.
FIREBASE_PROJECT_ID=
# Service-account key JSON (Project settings -> Service accounts -> Generate
# new private key). Accepts either the raw JSON string (e.g. on one line) or
# a file path (e.g. Render Secret File '/etc/secrets/firebase-service-account.json').
# Needed for admin operations (staff accounts, password resets, legacy-account
# migration); token verification works with the project id alone.
# NEVER commit real credentials - set in your local .env or Render secret store only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Database Configuration (Host Development)
# Use 'localhost' on host machine, 'db' inside Docker container
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gawachabazaar

# Razorpay (online payments). Empty key id = COD only. Use rzp_test_ keys
# locally; webhooks need a public URL (e.g. a tunnel) to reach you.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS (JSON array or comma-separated list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:3001"]

# Delivery pricing / Bazaar offer (free delivery at 15+ items; else base + per-km
# from the packing point). Set the packing point so the per-km part applies.
FREE_DELIVERY_MIN_ITEMS=15
DELIVERY_BASE_FEE=20
DELIVERY_PER_KM=10
DELIVERY_MAX_CHARGED_KM=30
PACKING_POINT_LATITUDE=
PACKING_POINT_LONGITUDE=
BAZAAR_PLUS_ORDERS_REQUIRED=6
BAZAAR_PLUS_WINDOW_DAYS=7
