# Application Configuration
APP_NAME=GawachaBazaar
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security
# Set a strong 32+ character random secret in local .env (never commit)
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Host Development)
# Use 'localhost' on host machine, 'db' inside Docker container
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gawachabazaar

# CORS (JSON array or comma-separated list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
