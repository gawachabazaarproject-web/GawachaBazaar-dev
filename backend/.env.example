# Application Configuration
APP_NAME=GawachaBazaar
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Firebase Authentication (identity provider)
# Project id: Firebase Console -> Project settings -> General.
FIREBASE_PROJECT_ID=
# Service-account key JSON (Project settings -> Service accounts -> Generate
# new private key). Accepts either the raw JSON string (e.g. on one line) or
# a file path (e.g. Render Secret File '/etc/secrets/firebase-service-account.json').
# Needed for admin operations (staff accounts, password resets, legacy-account
# migration); token verification works with the project id alone.
# NEVER commit real credentials - set in your local .env or Render secret store only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Database Configuration (Host Development)
# Use 'localhost' on host machine, 'db' inside Docker container
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gawachabazaar

# Razorpay (online payments). Empty key id = COD only. Use rzp_test_ keys
# locally; webhooks need a public URL (e.g. a tunnel) to reach you.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS (JSON array or comma-separated list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:3001"]

# Delivery pricing / Bazaar offer (free delivery at 15+ different products; else base + per-km
# from the packing point). Set the packing point so the per-km part applies.
FREE_DELIVERY_MIN_ITEMS=15
DELIVERY_BASE_FEE=40
DELIVERY_PER_KM=10
DELIVERY_MAX_CHARGED_KM=30
PACKING_POINT_LATITUDE=
PACKING_POINT_LONGITUDE=
# Road distance (OpenStreetMap, no paid API). The public OSRM server is for
# development only - self-host OSRM before launch (docs/05-domains/DELIVERY.md).
# If routing is down the delivery quote fails (503); no straight-line guess.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=3
# Customers farther than this by road are refused (0 = no limit); minimum order (0 = off)
DELIVERY_MAX_DISTANCE_KM=0
DELIVERY_MIN_ORDER_VALUE=0
# Database pool + guards (per worker; production runs ONE worker). In-flight cap
# must be <= pool_size + max_overflow. See docs/09-deployment-operations/AWS_PRODUCTION_PLAN.md
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=12
MAX_INFLIGHT_REQUESTS=24
DB_STATEMENT_TIMEOUT_MS=20000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Route-distance cache. Empty REDIS_URL = in-process cache; Redis outage never breaks delivery.
REDIS_URL=
ROUTE_CACHE_TTL_SECONDS=604800
# Address search (customer presses Search; never autocomplete on the public server)
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GawachaBazaar/1.0 (you@example.com)
BAZAAR_PLUS_ORDERS_REQUIRED=6
BAZAAR_TIMEZONE=Asia/Kolkata
